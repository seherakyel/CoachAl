FASTAPI_ENV=development
FASTAPI_PORT=8000
GEMINI_API_KEY=
GEMINI_MODEL=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# Comma-separated list of allowed frontend origins for CORS.
# Production örneği:  https://coachai.app,https://www.coachai.app
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Sentry DSN (boş bırakılırsa Sentry devre dışı)
SENTRY_DSN=
LOG_LEVEL=INFO

# Rate limit (dakika başı IP)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_GEMINI=20/minute

# Günlük UID kotaları (Firestore'da takip edilir)
DAILY_QUOTA_CV_UPLOAD=20
DAILY_QUOTA_COMPANY_ANALYZE=30
DAILY_QUOTA_ALIGNMENT=50
DAILY_QUOTA_CLASSIC_EXAM=15
DAILY_QUOTA_QUIZ=30
DAILY_QUOTA_FEEDBACK=30

LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
